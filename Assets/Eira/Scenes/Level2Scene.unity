  m_Script: {fileID: 11500000, guid: ea3e4e43d94857d42ad9d51510fb247c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EiraGame.NovaCompanion
  idleTips:
  - "Los drones te detectan m\xE1s lejos si corres. Ag\xE1chate (Ctrl) y usar\xE1s menos el radar."
  - "Si una m\xE1quina brilla en verde, act\xEDvala con F."
  - "Tu coraz\xF3n es tu energ\xEDa: el pulso con F lo consume, y si est\xE1s por debajo del 50% te har\xE1 da\xF1o."
  - "Los botiquines y c\xE1psulas de energ\xEDa te restauran. Busca sus luces."
  - "Mant\xE9n Shift para correr y Espacio para saltar. Presiona el rat\xF3n para girar la c\xE1mara."
  linesOnInfo: 
  lineOnPuzzle: 
  lineOnBoss: 
  lineOnBossEnd: 
  lineOnWin: 
